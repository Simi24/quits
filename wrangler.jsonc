{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quits",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-22",
  // Production is the Custom Domain only (SPEC.md §11.2): it creates its own DNS record. No workers.dev
  // URL, and no preview URLs, which would reach the production Durable Objects (SPEC.md G-B8).
  "routes": [{ "pattern": "quits.simonepetta.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // The API runs the Worker first; every other path is a static asset.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Logs hold only errors (SPEC.md §10.1): the automatic invocation log, which records every request, is off.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  // "eu" puts every Durable Object in the EU jurisdiction (SPEC.md §11.3). workerd, locally and in
  // tests, does not implement jurisdictions, so those runs set "none" (the only other value).
  "vars": { "JURISDICTION": "eu" },
  "durable_objects": {
    "bindings": [
      { "name": "TRIP", "class_name": "Trip" },
      { "name": "DIRECTORY", "class_name": "Directory" }
    ]
  },
  // Never edit a shipped migration: add a new tag (a bad migration can lose trips).
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Trip", "Directory"] }]
}
